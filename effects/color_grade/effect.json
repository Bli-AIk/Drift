{
  "id": "color.grade",
  "displayName": "Color Grade",
  "category": "color",
  "order": 5,
  "nextFeatures": ["param:curve", "curve:spline", "param:lut"],
  "parameters": [
    { "identifier": "exposure", "displayName": "Exposure", "type": "float", "group": "Light", "minValue": -4, "maxValue": 4, "defaultValue": 0 },
    { "identifier": "contrast", "displayName": "Contrast", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "highlights", "displayName": "Highlights", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "shadows", "displayName": "Shadows", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "whites", "displayName": "Whites", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "blacks", "displayName": "Blacks", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "temperature", "displayName": "Temperature", "type": "float", "group": "Color", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "tint", "displayName": "Tint", "type": "float", "group": "Color", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "saturation", "displayName": "Saturation", "type": "float", "group": "Color", "minValue": 0, "maxValue": 2, "defaultValue": 1 },
    { "identifier": "vibrance", "displayName": "Vibrance", "type": "float", "group": "Color", "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "lift", "displayName": "Shadows Color", "type": "vec2", "group": "Wheels", "groupCollapsed": true, "minValue": [-1, -1], "maxValue": [1, 1], "defaultValue": [0, 0] },
    { "identifier": "liftLuma", "displayName": "Shadows Brightness", "type": "float", "group": "Wheels", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "gamma", "displayName": "Midtones Color", "type": "vec2", "group": "Wheels", "groupCollapsed": true, "minValue": [-1, -1], "maxValue": [1, 1], "defaultValue": [0, 0] },
    { "identifier": "gammaLuma", "displayName": "Midtones Brightness", "type": "float", "group": "Wheels", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "gain", "displayName": "Highlights Color", "type": "vec2", "group": "Wheels", "groupCollapsed": true, "minValue": [-1, -1], "maxValue": [1, 1], "defaultValue": [0, 0] },
    { "identifier": "gainLuma", "displayName": "Highlights Brightness", "type": "float", "group": "Wheels", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "curveMaster", "displayName": "Master Curve", "type": "curve", "group": "Curves", "groupCollapsed": true, "defaultValue": [{"x": 0, "y": 0, "ease": "spline"}, {"x": 1, "y": 1, "ease": "spline"}] },
    { "identifier": "curveR", "displayName": "Red Curve", "type": "curve", "group": "Curves", "groupCollapsed": true, "defaultValue": [{"x": 0, "y": 0, "ease": "spline"}, {"x": 1, "y": 1, "ease": "spline"}] },
    { "identifier": "curveG", "displayName": "Green Curve", "type": "curve", "group": "Curves", "groupCollapsed": true, "defaultValue": [{"x": 0, "y": 0, "ease": "spline"}, {"x": 1, "y": 1, "ease": "spline"}] },
    { "identifier": "curveB", "displayName": "Blue Curve", "type": "curve", "group": "Curves", "groupCollapsed": true, "defaultValue": [{"x": 0, "y": 0, "ease": "spline"}, {"x": 1, "y": 1, "ease": "spline"}] },

    { "identifier": "look", "displayName": "Look", "type": "lut", "group": "Look", "defaultValue": "" },
    { "identifier": "lookAmount", "displayName": "Look Intensity", "type": "float", "group": "Look", "minValue": 0, "maxValue": 1, "defaultValue": 1 }
  ],
  "backend": "gpu",
  "pipeline": {
    "intermediateBuffers": [],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "main.frag",
        "inputs": [
          { "type": "source_texture" }
        ],
        "output": { "type": "canvas" }
      }
    ]
  }
}
